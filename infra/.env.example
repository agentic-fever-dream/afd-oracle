# Copy to infra/.env (read by docker compose AND by the afd-oracle CLI / MCP server).
# --- docker compose ---
NEO4J_AUTH=neo4j/change-me-please
QDRANT_API_KEY=
# --- afd-oracle CLI + MCP server (must match the values above) ---
AFD_ORACLE_NEO4J_URI=bolt://127.0.0.1:7687
AFD_ORACLE_NEO4J_USER=neo4j
AFD_ORACLE_NEO4J_PASSWORD=change-me-please
AFD_ORACLE_QDRANT_URL=http://127.0.0.1:6333
AFD_ORACLE_QDRANT_API_KEY=
# Embeddings: fastembed (local ONNX) or hash (offline/deterministic, low quality)
AFD_ORACLE_EMBEDDER=fastembed
AFD_ORACLE_EMBED_MODEL=jinaai/jina-embeddings-v2-base-code
AFD_ORACLE_EMBED_DIM=768
# Embedded Qdrant (no server): set a directory, e.g.
# AFD_ORACLE_QDRANT_PATH=data/qdrant-local
